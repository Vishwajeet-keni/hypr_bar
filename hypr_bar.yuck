;including widgets
  (include "hypr_bar/widgets/bar/Arch_logo.yuck")
  (include "hypr_bar/widgets/bar/workspace.yuck")
  (include "hypr_bar/widgets/bar/system_stats.yuck")
  (include "hypr_bar/widgets/bar/updates.yuck")
  (include "hypr_bar/widgets/bar/wifi.yuck")
  (include "hypr_bar/widgets/bar/battery.yuck")
  (include "hypr_bar/widgets/bar/menu.yuck")
  (include "hypr_bar/widgets/bar/time_date_cal.yuck")

  (include "hypr_bar/widgets/control_center/control_center.yuck")
  (include "hypr_bar/widgets/control_center/tiles.yuck")


;;hypr_var
(defwindow hypr_bar
  :monitor 0
  :windowtype "dock"
  :hexpand "false"
  :vexpand "false"
  :geometry (geometry
    :anchor "top center"
    :x "0"
    :y "3"
    :width "98.8%"
    :height "26px"
  )
  :stacking "fg"
  :exclusive "true"
  :focusable "false"
  
  (centerbox
    :class "base_div"
    :orientation "h"
    :spacing 10
    
    (box
      :class "left"
      :halign "start"
      :space-evenly false
      :spacing 10
      (Arch_logo)
      (workspace)
    )
    
    (box
      :class "center"
      :halign "center"
      ;"pass"
      
    )
    
    (box
      :class "right"
      :halign "end"
      :space-evenly false
      :spacing 8
      (system_stats)
      ; (updates)
      ; (wifi)
      ; (battery)
      (menu)  ;===> includes updates wifi & battery
      (time_date_cal)
    )
  )
)



(defwindow low_batt_warning
  :monitor 0
  :windowtype "dialog"
  :geometry (geometry
    :anchor "center"
    :width "200px"
    :height "20px"
  )
  :stacking "overlay"
  :focusable "true"
  (low_batt_warning)
)



(defwindow cal_popup
  :monitor 0
  ; :windowtype "normal"
  :namespace "eww-control-panel"
  :geometry (geometry :x "8px"
                      :y "8px"
                      :anchor "top right"
                      :width "200px")
  :stacking "overlay"
  :focusable "false"
  (eventbox
    :onhoverlost "eww close cal_popup"
    (calendar :class "cal"
              :day {EWW_TIME.day}
              :month {EWW_TIME.month}
              :year {EWW_TIME.year})
  )
)



;; The actual Window declaration
(defwindow control_panel
  :monitor 0
  :namespace "eww-control-panel"
  :geometry (geometry :x "8px" 
                      :y "8px" 
                      :anchor "top right" 
                      :width "320px" 
                      :height "2px") ;; Explicitly declaring height prevents layout load bugs
  :stacking "overlay" ;; Changed from "fg" to "overlay" to sit neatly above everything else
  :focusable "false"
  (control_center)
)