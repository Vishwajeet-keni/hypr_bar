;=====Control Center — Composition===============================
; This file owns the data this feature needs and wires it into the
; generic tiles from tiles.yuck. wifi-data already exists in
; widgets/wifi.yuck and is reused as-is here — do NOT add a second
; wifi poller, or the bar icon and this tile can drift out of sync.
(defpoll bluetooth-data  :interval "2s" "~/.config/eww/hypr_bar/scripts/bluetooth.sh")
(defpoll brightness-data :interval "2s" "~/.config/eww/hypr_bar/scripts/brightness.sh")
(defpoll volume-data     :interval "2s" "~/.config/eww/hypr_bar/scripts/volume.sh")
(defpoll power_mode-data :interval "2s" "~/.config/eww/hypr_bar/scripts/power_mode.sh")


(defwidget control_center []
  (eventbox :onhoverlost "sleep 0.1 && eww close control_panel"
    (box :class "cc-window" :orientation "v" :space-evenly false

      ;; Top Row: Connections & Quick Actions
      (box :class "cc-row" :orientation "h" :space-evenly true

        ;; Left Block: Wi-Fi, Bluetooth, AirDrop
        (box :class "network-box" :orientation "v" :space-evenly true
          (cc-toggle-tile
            :icon "${wifi-data.icon}"
            :icon-class "icon-blue"
            :title "Wi-Fi"
            :subtitle "${wifi-data.status}"
            :onclick "~/.config/eww/hypr_bar/scripts/wifi.sh toggle")
          (cc-toggle-tile
            :icon "${bluetooth-data.icon}"
            :icon-class "icon-blue"
            :title "Bluetooth"
            :subtitle "${bluetooth-data.status}"
            :onclick "~/.config/eww/hypr_bar/scripts/bluetooth.sh toggle"))

        ;; Right Block: Stacked squares
        (box :orientation "v" :space-evenly true :class "right-toggles"
          ;; notification daemon you run (mako/dunst) before it can toggle
          ;; anything real.
          (cc-toggle-tile
            :icon "${power_mode-data.icon}"
            :icon-class "icon-blue"
            :title "Power-Mode"
            :subtitle "${power_mode-data.mode}"
            :onclick "~/.config/eww/hypr_bar/scripts/power_mode.sh toggle")

          (box :orientation "h" :space-evenly true :class "sub-grid"
            ;; Stage Manager / Screen Mirroring have no direct Linux
            ;; equivalent — static placeholders for now.
            (cc-icon-tile :icon "󰕰" :title "Stage")
            (cc-icon-tile :icon "󰕟" :title "Mirror"))))

      ; Middle Row: Display Slider (brightnessctl)
      (cc-slider
        :label "Display"
        :value {brightness-data.value}
        :min 1 :max 100
        :onchange "~/.config/eww/hypr_bar/scripts/brightness.sh set {}")

      ; Bottom Row: Sound Slider (wpctl)
      (cc-slider
        :label "Sound"
        :value {volume-data.value}
        :min 0 :max 100
        :onchange "~/.config/eww/hypr_bar/scripts/volume.sh set {}")
    )
  )
)