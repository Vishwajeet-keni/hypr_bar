;=====Time_Date_Calender=======================================
(deflisten time_listen :initial "loading..."
  "while true; do date '+%a %d-%b %H:%M'; sleep 10; done")
(defwidget time_date_cal []
  (eventbox
    :onclick "eww open cal_popup"
    :onhoverlost "sleep 0.3 && eww close cal_popup 2>/dev/null"
    (box :class "time_container"
      (label :class "time" :text time_listen)
    )
  )
)